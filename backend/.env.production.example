# ══════════════════════════════════════════════════
#  NOVA Store — Variables de entorno PRODUCCIÓN
#  Copiá este archivo a .env y completá los valores
# ══════════════════════════════════════════════════

# Aplicación
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://nova_user:TU_PASSWORD_SEGURA@localhost:5432/nova_prod?schema=public"

# JWT — Generá una clave aleatoria con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_CON_CLAVE_ALEATORIA_DE_64_BYTES
JWT_EXPIRATION=7d

# Stripe (pagos reales)
# Obtené las claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXX

# URL del frontend (sin barra al final)
# Si tenés múltiples dominios, separarlos con coma
FRONTEND_URL=https://TU_DOMINIO.com

# Cloudinary (imágenes de productos)
# Obtené las credenciales en https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email (para notificaciones de pedidos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_de_gmail
